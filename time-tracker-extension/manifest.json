{
  "manifest_version": 3,
  "name": "מד זמן לפרויקטים",
  "version": "1.3.1",
  "description": "מדידת זמן עבודה לכל פרויקט בלחיצה אחת.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "מד זמן לפרויקטים",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}